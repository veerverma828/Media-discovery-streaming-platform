# Port the Express server listens on
PORT=5000

# Trakt.tv API app credentials (https://trakt.tv/oauth/applications)
# Required for the /trakt/* device-auth and proxy routes.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Jackett instance, used by /search
JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=

# Real-Debrid / Torbox: no server-side keys needed. Each user adds their own
# API key in the app (Settings > Debrid); it is sent per-request in the
# x-debrid-key header.
